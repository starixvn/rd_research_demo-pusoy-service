{
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES2017",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": true,
        "allowSyntheticDefaultImports": true,
        "allowJs": true
    }
}

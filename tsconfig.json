{
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES2017",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "rootDirs": ["./src", "./configs"],
        "outDir": "./dist",
        "declaration": true,
        "allowSyntheticDefaultImports": true,
        "allowJs": true
    },
    "exclude": ["node_modules", "dist"],
    "include": ["src/**/*"]
}
